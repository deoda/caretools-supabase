# Copiez ce fichier en .env et renseignez vos valeurs. Ne commitez jamais .env.
# Si ces variables sont absentes, l'application utilise les valeurs par défaut de
# src/services/supabase.js. La clé « publishable » est publique par conception :
# la sécurité repose sur la RLS (supabase/migrations/001_schema_rls.sql).
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
